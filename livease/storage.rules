rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Complaint photos: residents upload into their own folder only.
    // Images only, max 5 MB. Any signed-in user can view them (admins need to).
    match /complaints/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
